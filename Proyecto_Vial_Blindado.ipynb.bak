     ]
    }
   ],
   "source": [
    "datos = {}\n",
    "for cont, patron in CONTENEDORES.items():\n",
    "    datos[cont] = {}\n",
    "    for d in DISTANCIAS:\n",
    "        carpeta = BASE / patron.format(d=d)\n",
    "        if not carpeta.exists():\n",
    "            print(f\"[FALTA] {cont} · {d} mm → no existe {carpeta}\"); continue\n",
    "        f_dosis, f_unc = buscar_archivos(carpeta, d)\n",
    "        f_meta = carpeta / \"metadata_simulacion.json\"\n",
    "        if f_dosis is None or f_unc is None or not f_meta.exists():\n",
    "            print(f\"[INCOMPLETO] {carpeta}: dosis={f_dosis} unc={f_unc} meta={f_meta.exists()}\"); continue\n",
    "        meta = json.loads(f_meta.read_text(encoding=\"utf-8\"))\n",
    "        datos[cont][d] = dict(\n",
    "            dosis  = leer_mhd(f_dosis)[:, :, 0],   # (nz, ny)  dosis TOTAL de la corrida (Gy)\n",
    "            unc    = leer_mhd(f_unc)[:, :, 0],     # incertidumbre relativa por vóxel\n",
    "            n_prim = meta[\"n_primarios_simulados\"],\n",
    "            lado   = meta[\"detector\"][\"lado_mm\"],\n",
    "        )\n",
    "        print(f\"[OK] {cont:22s} {d:5d} mm | {datos[cont][d]['n_prim']:>12,} primarios | \"\n",
    "              f\"{f_dosis.name}, {f_unc.name}\")"
   ]
  },
