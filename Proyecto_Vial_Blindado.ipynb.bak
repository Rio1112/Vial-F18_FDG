   ],
   "source": [
    "LAMBDA = np.log(2) / T_MEDIA_F18_S\n",
    "A0_BQ  = ACTIVIDAD_MCI * BQ_POR_MCI\n",
    "N_DEC  = (A0_BQ / LAMBDA) * (1 - np.exp(-LAMBDA * T_EXPO_S)) if CORREGIR_DECAIMIENTO \\\n",
    "         else A0_BQ * T_EXPO_S\n",
    "print(f\"Decaimientos reales en {T_EXPO_S/60:.0f} min: {N_DEC:.4e} \"\n",
    "      f\"({'con' if CORREGIR_DECAIMIENTO else 'sin'} corrección por decaimiento)\")\n",
    "\n",
    "filas = []\n",
    "for cont, por_d in datos.items():\n",
    "    for d, r in sorted(por_d.items()):\n",
    "        f = N_DEC / r[\"n_prim\"]                       # decaimientos reales / primarios simulados\n",
    "        D = r[\"dosis\"] * f                            # Gy en cada vóxel\n",
    "        u = np.where(r[\"dosis\"] > 0, r[\"unc\"], 1.0)   # vóxel sin eventos → 100 %\n",
    "        media = D.mean()                              # Gy es intensiva → media sobre vóxeles\n",
    "        sigma_media = np.sqrt(np.sum((D * u) ** 2)) / D.size   # incertidumbre estadística de la media\n",
    "        c = D.shape[0] // 2\n",
    "        r.update(D=D, u=u, factor=f, media=media, sigma_media=sigma_media)\n",
    "        filas.append({\n",
    "            \"Contenedor\": cont, \"d (mm)\": d, \"Primarios\": r[\"n_prim\"],\n",
    "            \"Media plano (µGy)\":       media * 1e6,\n",
    "            \"σ estadística (%)\":       100 * sigma_media / media,\n",
    "            \"Desv. espacial (µGy)\":    D.std(ddof=1) * 1e6,    # variación entre vóxeles\n",
    "            \"CV espacial (%)\":         100 * D.std(ddof=1) / media,\n",
    "            \"Centro (µGy)\":            D[c, c] * 1e6,\n",
    "            \"Incert. centro (%)\":      100 * u[c, c],\n",
    "            \"Incert. máx vóxel (%)\":   100 * u.max(),\n",
    "            \"¿< 10 % en todos?\":       \"sí\" if u.max() <= UMBRAL_INCERT else \"NO\",\n",
    "        })\n",
    "tabla = pd.DataFrame(filas)\n",
    "display(tabla.round({\"Media plano (µGy)\": 4, \"σ estadística (%)\": 2, \"Desv. espacial (µGy)\": 4,\n",
    "                     \"CV espacial (%)\": 1, \"Centro (µGy)\": 4, \"Incert. centro (%)\": 2,\n",
    "                     \"Incert. máx vóxel (%)\": 1}))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "80f9e384-fa7f-4f4a-91c6-b84e94ca2650",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Plomo (CT/A-30)         exponente n = 1.718 ± 0.033   (1/r² → n = 2)\n",
      "Tungsteno (CT/A-30W)    exponente n = 1.814 ± 0.072   (1/r² → n = 2)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1870x528 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from matplotlib.ticker import NullFormatter\n",
    "\n",
    "def serie(cont):\n",
    "    ds = sorted(datos[cont]); r = [datos[cont][d] for d in ds]\n",
    "    x   = np.array(ds) / 10.0                                  # cm\n",
    "    m   = np.array([k[\"media\"] for k in r]) * 1e6              # µGy\n",
    "    rel = np.array([k[\"sigma_media\"] / k[\"media\"] for k in r])\n",
    "    return x, m, rel\n",
    "\n",
    "fig, ax = plt.subplots(1, 3, figsize=(17, 4.8))\n",
    "S = {}\n",
    "for cont in CONTENEDORES:\n",
    "    if not datos[cont]: continue\n",
    "    x, m, rel = serie(cont); S[cont] = (x, m, rel); c = COLORES[cont]\n",
    "    # (a) dosis media vs distancia (log-log) + referencia 1/r² anclada al primer punto\n",
    "    ax[0].errorbar(x, m, yerr=m * rel, fmt=\"o-\", color=c, ms=6, lw=1.8, capsize=3, label=cont)\n",
    "    ax[0].plot(x, m[0] * (x[0] / x) ** 2, ls=\":\", color=c, lw=1.2)\n",
    "    # ajuste D ∝ r^-n ponderado por la incertidumbre\n",
    "    p, cov = np.polyfit(np.log(x), np.log(m), 1, w=1 / np.maximum(rel, 1e-6), cov=\"unscaled\")\n",
    "    print(f\"{cont:22s}  exponente n = {-p[0]:.3f} ± {np.sqrt(cov[0, 0]):.3f}   (1/r² → n = 2)\")\n",
    "    # (b) D·r² normalizado al primer punto (si solo fuera geometría → 1)\n",
    "    y = m * x ** 2; y = y / y[0]\n",
    "    ey = y * np.sqrt(rel ** 2 + rel[0] ** 2); ey[0] = 0\n",
    "    ax[1].errorbar(x, y, yerr=ey, fmt=\"o-\", color=c, ms=6, lw=1.8, capsize=3, label=cont)\n",
    "\n",
    "ax[0].set(xscale=\"log\", yscale=\"log\", xlabel=\"Distancia al eje (cm)\", ylabel=\"Dosis media del plano (µGy)\",\n",
    "          title=\"(a) Dosis vs distancia · 100 mCi, 1 h\")\n",
    "ax[0].set_xticks([d / 10 for d in DISTANCIAS]); ax[0].set_xticklabels([f\"{d/10:.0f}\" for d in DISTANCIAS])\n",
    "ax[0].xaxis.set_minor_formatter(NullFormatter())\n",
    "h = ax[0].get_legend_handles_labels()\n",
    "ax[0].legend(h[0] + [Line2D([], [], ls=\":\", color=TINTA2, lw=1.2)], h[1] + [\"1/r² (referencia)\"])\n",
    "ax[1].axhline(1, color=TINTA2, lw=0.8, ls=\"--\")\n",
    "ax[1].set(xlabel=\"Distancia al eje (cm)\", ylabel=\"D·r² / (D·r²) a 20 cm\",\n",
    "          title=\"(b) Desviación respecto a 1/r²\"); ax[1].legend()\n",
    "\n",
    "# (c) cuántas veces atenúa más el tungsteno que el plomo\n",
    "pb, w = list(CONTENEDORES)[:2]\n",
    "if pb in S and w in S:\n",
    "    x, m1, r1 = S[pb]; _, m2, r2 = S[w]\n",
    "    ratio = m1 / m2; err = ratio * np.sqrt(r1 ** 2 + r2 ** 2)\n",
    "    ax[2].errorbar(x, ratio, yerr=err, fmt=\"o-\", color=TINTA2, ms=6, lw=1.8, capsize=3)\n",
    "    ax[2].set(xlabel=\"Distancia al eje (cm)\", ylabel=\"Dosis Pb / Dosis W\",\n",
    "              title=\"(c) Atenuación extra del tungsteno\", ylim=(0, (ratio + err).max() * 1.25))\n",
    "    for xi, ri in zip(x, ratio): ax[2].annotate(f\"{ri:.1f}×\", (xi, ri), textcoords=\"offset points\",\n",
    "                                                xytext=(0, 9), ha=\"center\", fontsize=9, color=TINTA)\n",
    "fig.tight_layout(); fig.savefig(\"fig_atenuacion.png\", dpi=200, bbox_inches=\"tight\"); plt.show()"
   ]
  },
