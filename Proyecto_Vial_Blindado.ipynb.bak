   "source": [
    "# ── CELDA 9 · Tasa de dosis vs distancia: MC + teoría point-kernel + límites ─\n",
    "from matplotlib.ticker import NullFormatter\n",
    "TASA_INICIAL      = True    # True: tasa en t=0 (actividad A0, conservador) · False: promedio de la hora\n",
    "W_R               = 1.0     # fotones: Sv = Gy · w_R\n",
    "LIM_TRAB_MSV_ANIO = 20.0    # ICRP 103: trabajador (promedio 5 años)\n",
    "LIM_PUBL_MSV_ANIO = 1.0     # ICRP 103: público\n",
    "HORAS_ANIO        = 2000.0  # horas/año para convertir límite anual → tasa\n",
    "LIMITES = {                 # µSv/h\n",
    "    f\"Límite trabajador ({LIM_TRAB_MSV_ANIO:g} mSv/año ≈ {LIM_TRAB_MSV_ANIO*1e3/HORAS_ANIO:g} µSv/h)\": LIM_TRAB_MSV_ANIO * 1e3 / HORAS_ANIO,\n",
    "    f\"Límite público ({LIM_PUBL_MSV_ANIO:g} mSv/año ≈ {LIM_PUBL_MSV_ANIO*1e3/HORAS_ANIO:g} µSv/h)\":    LIM_PUBL_MSV_ANIO * 1e3 / HORAS_ANIO,\n",
    "}\n",
    "N_H = A0_BQ * 3600.0 if TASA_INICIAL else N_DEC * 3600.0 / T_EXPO_S      # decaimientos por hora\n",
    "\n",
    "# ── Geometría para el point-kernel (capas que cruza un rayo horizontal) ──\n",
    "GEOM = {   # (μ en cm⁻¹ @511 keV, espesor en mm) · z de la fuente en mm\n",
    "    \"Plomo (CT/A-30)\":      dict(z_fuente=-22.35, capas=[(1.781, 32.0), (0.624, 2.0)]),   # Pb + acero\n",
    "    \"Tungsteno (CT/A-30W)\": dict(z_fuente=-13.85, capas=[(2.598, 29.5)]),                  # solo W\n",
    "}\n",
    "CAPAS_COMUNES = [(0.19, 1.5), (0.0966, 0.85 * 11.0)]     # vidrio; agua (camino medio ≈ 0.85·R)\n",
    "# Factor de acumulación B(μx), fuente puntual isótropa, 0.5 MeV.\n",
    "# Valores aproximados: sustituir por los de ANS-6.4.3 (Shultis & Faw) del material.\n",
    "MUX_TAB = [0, 1, 2, 4, 7, 10, 15, 20]\n",
    "B_TAB   = [1, 1.24, 1.42, 1.69, 2.00, 2.27, 2.65, 3.00]\n",
    "\n",
    "def tasa_teorica(cont, d_mm, lado_mm, buildup=True, n=41):\n",
    "    \"\"\"Tasa de dosis media sobre el plano (Gy/h), point-kernel con trayectoria oblicua.\"\"\"\n",
    "    g = GEOM[cont]\n",
    "    c = (np.arange(n) + 0.5) / n * lado_mm - lado_mm / 2\n",
    "    Y, Z = np.meshgrid(c, c)\n",
    "    L = np.sqrt(d_mm ** 2 + Y ** 2 + (Z - g[\"z_fuente\"]) ** 2)\n",
    "    s = np.sqrt(d_mm ** 2 + Y ** 2) / L                       # componente horizontal del rayo\n",
    "    mux = sum(mu * t / 10.0 / s for mu, t in g[\"capas\"] + CAPAS_COMUNES)\n",
    "    B = np.interp(mux, MUX_TAB, B_TAB) if buildup else 1.0\n",
    "    D = N_H * FOTONES_POR_DECAIM * (E_FOTON_MEV * MEV_A_J) * MUEN_RHO_CM2_G * 1000 \\\n",
    "        * B * np.exp(-mux) / (4 * np.pi * (L ** 2 / 100.0))\n",
    "    return D.mean()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8.8, 5.6))\n",
    "filas_r = []\n",
    "for cont in CONTENEDORES:\n",
    "    por_d = datos[cont]\n",
    "    if not por_d: continue\n",
    "    c = COLORES[cont]; ds = sorted(por_d)\n",
    "    x   = np.array(ds) / 10.0                                                     # cm\n",
    "    mc  = np.array([por_d[d][\"dosis\"].mean() * N_H / por_d[d][\"n_prim\"] for d in ds]) * W_R * 1e6   # µSv/h\n",
    "    rel = np.array([por_d[d][\"sigma_media\"] / por_d[d][\"media\"] for d in ds])\n",
    "    k_lado = por_d[ds[0]][\"lado\"] / ds[0]                                         # lado = k·d\n",
    "    # teoría: banda entre sin acumulación (B=1) y con acumulación B(μx)\n",
    "    dd = np.linspace(min(ds) * 0.8, max(ds) * 1.1, 60)\n",
    "    lo = np.array([tasa_teorica(cont, d, k_lado * d, buildup=False) for d in dd]) * W_R * 1e6\n",
    "    hi = np.array([tasa_teorica(cont, d, k_lado * d, buildup=True)  for d in dd]) * W_R * 1e6\n",
    "    ax.fill_between(dd / 10, lo, hi, color=c, alpha=0.22, lw=0, label=f\"Teoría point-kernel · {cont.split()[0]} (B=1 … B(μx))\")\n",
    "    ax.plot(dd / 10, hi, color=c, lw=1.2, ls=\"--\")\n",
    "    ax.errorbar(x, mc, yerr=mc * rel, fmt=\"o\", color=c, ms=7, mec=\"white\", mew=1.2, capsize=3, lw=1.6,\n",
    "                label=f\"Monte Carlo · {cont}\")\n",
    "    # distancia a la que la tasa MC cae al límite (ajuste log-log ponderado)\n",
    "    p, q = np.polyfit(np.log(x), np.log(mc), 1, w=1 / np.maximum(rel, 1e-6))\n",
    "    for nom, lim in LIMITES.items():\n",
    "        x_lim = np.exp((np.log(lim) - q) / p)\n",
    "        print(f\"{cont:22s} → {nom.split('(')[0].strip():16s}: {x_lim:7.1f} cm \"\n",
    "              f\"{'' if x[0] <= x_lim <= x[-1] else '(EXTRAPOLADO fuera de 20–100 cm)'}\")\n",
    "    for i, d in enumerate(ds):\n",
    "        th = tasa_teorica(cont, d, k_lado * d, True) * W_R * 1e6\n",
    "        filas_r.append({\"Contenedor\": cont, \"d (cm)\": d / 10, \"MC (µSv/h)\": mc[i], \"± (%)\": 100 * rel[i],\n",
    "                        \"Teoría B=1 (µSv/h)\": tasa_teorica(cont, d, k_lado * d, False) * W_R * 1e6,\n",
    "                        \"Teoría B(μx) (µSv/h)\": th, \"MC / teoría\": mc[i] / th})\n",
    "\n",
    "# Límites: líneas neutras con etiqueta directa\n",
    "estilos = [\"--\", \":\"]\n",
    "for (nom, lim), ls in zip(LIMITES.items(), estilos):\n",
    "    ax.axhline(lim, color=TINTA, lw=1.4, ls=ls)\n",
    "    ax.text(0.99, lim * 1.08, nom, transform=ax.get_yaxis_transform(), ha=\"right\", va=\"bottom\", fontsize=8.5,\n",
    "            color=TINTA, bbox=dict(facecolor=\"white\", edgecolor=\"none\", alpha=0.85, pad=1.5))\n",
    "ax.set(xscale=\"log\", yscale=\"log\", xlabel=\"Distancia al eje del contenedor (cm)\", ylabel=\"Tasa de dosis (µSv/h)\",\n",
    "       title=f\"Tasa de dosis vs distancia · {ACTIVIDAD_MCI:g} mCi de F-18 \"\n",
    "             f\"({'tasa inicial' if TASA_INICIAL else 'promedio 1 h'})\")\n",
    "ax.set_xticks([d / 10 for d in DISTANCIAS]); ax.set_xticklabels([f\"{d/10:.0f}\" for d in DISTANCIAS])\n",
    "ax.xaxis.set_minor_formatter(NullFormatter())\n",
    "ax.legend(loc=\"lower left\", fontsize=8.5)\n",
    "fig.tight_layout(); fig.savefig(\"fig_tasa_dosis.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
    "display(pd.DataFrame(filas_r).round({\"d (cm)\": 0, \"MC (µSv/h)\": 3, \"± (%)\": 1, \"Teoría B=1 (µSv/h)\": 3,\n",
    "                                      \"Teoría B(μx) (µSv/h)\": 3, \"MC / teoría\": 2}))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "61c77c96-d063-44ad-ba82-cd8666465eb4",
   "metadata": {},
   "source": [
    "## 4. Conclusiones\n",
    "\n",
    "### 4.1 Atenuación: tungsteno vs. plomo\n",
    "\n",
    "El modelo Point-Kernel predice un factor de atenuación de **~3.4×** a favor del tungsteno, consecuencia de la diferencia en coeficientes de atenuación (μ_W = 2.402 cm⁻¹ vs. μ_Pb = 1.781 cm⁻¹) y los espesores de cada contenedor.\n",
    "\n",
    "### 4.2 Cumplimiento de límites ICRP\n",
    "\n",
    "- **Trabajadores (20 mSv/año → 2.28 µSv/h):** ambos contenedores se sitúan por debajo del límite a partir de ~20–30 cm del centro.\n",
    "- **Público general (1 mSv/año → 0.114 µSv/h):** el tungsteno alcanza este umbral a menor distancia que el plomo.\n",
    "\n"
   ]
  },
