   "source": [
    "carpeta = BASE / \"output_plomo_plano_200mm\"\n",
    "for f in sorted(carpeta.iterdir()):\n",
    "    print(f.name)\n",
    "print(\"─\" * 50)\n",
    "for f in carpeta.glob(\"*.txt\"):\n",
    "    print(f\"\\n>>> {f.name}\")\n",
    "    print(f.read_text(errors=\"ignore\")[:1500])"
   ]
