   "source": [
    "def dosis_sin_blindaje(d_mm, lado_mm, nvox, n_dec, sub=10):\n",
    "    \"\"\"Dosis (Gy) en cada vóxel si NO hubiera contenedor: D = Φ·E·(μen/ρ), Φ = N·1.9372/(4π r²).\n",
    "    Se promedia 1/r² dentro de cada vóxel (sub×sub puntos). Devuelve array (nz, ny).\"\"\"\n",
    "    c = (np.arange(nvox * sub) + 0.5) / (nvox * sub) * lado_mm - lado_mm / 2\n",
    "    Y, Z = np.meshgrid(c, c)                                   # filas = Z, columnas = Y\n",
    "    r2_cm2 = (d_mm ** 2 + Y ** 2 + Z ** 2) / 100.0\n",
    "    D0 = n_dec * FOTONES_POR_DECAIM * (E_FOTON_MEV * MEV_A_J) * MUEN_RHO_CM2_G * 1000 \\\n",
    "         / (4 * np.pi * r2_cm2)\n",
    "    return D0.reshape(nvox, sub, nvox, sub).mean(axis=(1, 3))\n",
    "\n",
    "filas_t = []\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11.5, 4.6))\n",
    "for cont in CONTENEDORES:\n",
    "    por_d = datos[cont]\n",
    "    if not por_d: continue\n",
    "    ds = sorted(por_d); Tm, eT = [], []\n",
    "    for d in ds:\n",
    "        r = por_d[d]; nv = r[\"D\"].shape[0]\n",
    "        r[\"D0\"] = dosis_sin_blindaje(d, r[\"lado\"], nv, N_DEC)\n",
    "        T = r[\"media\"] / r[\"D0\"].mean()                        # transmisión media del plano\n",
    "        eT_i = T * r[\"sigma_media\"] / r[\"media\"]\n",
    "        Tm.append(T); eT.append(eT_i)\n",
    "        c = nv // 2\n",
    "        filas_t.append({\"Contenedor\": cont, \"d (mm)\": d,\n",
    "                        \"Sin blindaje (µGy)\": r[\"D0\"].mean() * 1e6,\n",
    "                        \"Con blindaje MC (µGy)\": r[\"media\"] * 1e6,\n",
    "                        \"Transmisión T\": T, \"± T\": eT_i, \"Atenuación 1/T\": 1 / T,\n",
    "                        \"T centro\": r[\"D\"][c, c] / r[\"D0\"][c, c]})\n",
    "    ax[0].errorbar(np.array(ds) / 10, Tm, yerr=eT, fmt=\"o-\", color=COLORES[cont], ms=6, lw=1.8,\n",
    "                   capsize=3, label=cont)\n",
    "ax[0].set(yscale=\"log\", xlabel=\"Distancia al eje (cm)\", ylabel=\"T = D(MC) / D(sin blindaje)\",\n",
    "          title=\"Transmisión del blindaje (media del plano)\"); ax[0].legend()\n",
    "\n",
    "tab_t = pd.DataFrame(filas_t)\n",
    "# (b) barras agrupadas: dosis sin blindaje vs con Pb vs con W\n",
    "xs = np.arange(len(DISTANCIAS)); ancho = 0.27\n",
    "ref = tab_t[tab_t[\"Contenedor\"] == list(CONTENEDORES)[0]].set_index(\"d (mm)\")[\"Sin blindaje (µGy)\"]\n",
    "ax[1].bar(xs - ancho, [ref.get(d, np.nan) for d in DISTANCIAS], ancho * 0.92, color=\"#c3c2b7\", label=\"Sin blindaje\")\n",
    "for k, cont in enumerate(CONTENEDORES):\n",
    "    sub_ = tab_t[tab_t[\"Contenedor\"] == cont].set_index(\"d (mm)\")[\"Con blindaje MC (µGy)\"]\n",
    "    ax[1].bar(xs + k * ancho, [sub_.get(d, np.nan) for d in DISTANCIAS], ancho * 0.92,\n",
    "              color=COLORES[cont], label=cont)\n",
    "ax[1].set(yscale=\"log\", xticks=xs, xticklabels=[f\"{d/10:.0f}\" for d in DISTANCIAS],\n",
    "          xlabel=\"Distancia al eje (cm)\", ylabel=\"Dosis media (µGy)\", title=\"Dosis con y sin blindaje\")\n",
    "ax[1].legend(); ax[1].grid(axis=\"x\", visible=False)\n",
    "fig.tight_layout(); fig.savefig(\"fig_transmision.png\", dpi=200, bbox_inches=\"tight\"); plt.show()\n",
    "display(tab_t.round({\"Sin blindaje (µGy)\": 3, \"Con blindaje MC (µGy)\": 4, \"Transmisión T\": 5,\n",
    "                     \"± T\": 5, \"Atenuación 1/T\": 1, \"T centro\": 5}))"
   ]
